@{
    ViewData["Title"] = "Patients";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/patient.css" asp-append-version="true" />
    <style>
        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .status-active {
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.3);
            color: #A7F3D0;
        }
        .status-inactive {
            background: rgba(148, 163, 184, 0.1);
            border: 1px solid rgba(148, 163, 184, 0.3);
            color: #E2E8F0;
        }
        .status-pending {
            background: rgba(139, 92, 246, 0.1);
            border: 1px solid rgba(139, 92, 246, 0.3);
            color: #C7D2FE;
        }
        
        /* Modal Glassmorphism */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(7, 11, 19, 0.7);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        .modal-overlay.active {
            display: flex;
            opacity: 1;
        }
        .modal-content-glass {
            max-width: 480px;
            width: 90%;
            background: rgba(13, 21, 39, 0.85);
            border: 1px solid var(--border-glass);
            box-shadow: 0 16px 40px rgba(0,0,0,0.5);
            border-radius: var(--border-radius-md);
            padding: var(--spacing-lg);
            transform: scale(0.9);
            transition: transform 0.3s ease;
            text-align: center;
        }
        .modal-overlay.active .modal-content-glass {
            transform: scale(1);
        }

        .spinner {
            border: 3px solid rgba(255,255,255,0.05);
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border-left-color: var(--color-primary);
            animation: spin 1s linear infinite;
            margin: var(--spacing-lg) auto;
        }
        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
}

<!-- Client-side authentication check -->
<script>
    if (!localStorage.getItem('token')) {
        window.location.href = '/Account/Login';
    }
</script>

<div class="container patient-container animate-fade-in">
    <div class="patient-top-bar">
        <div>
            <h1 style="font-size: 2.2rem; font-weight: 700; background: linear-gradient(135deg, var(--text-main) 30%, var(--color-primary) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                Patient Directory
            </h1>
            <p style="color: var(--text-muted); font-size: 0.95rem;">Manage, search, and view patient profiles.</p>
        </div>
        
        <a href="/PatientView/Add" class="btn-primary" style="text-decoration: none;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: var(--spacing-sm);">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Add Patient
        </a>
    </div>

    <div class="glass-card" style="padding: var(--spacing-lg); margin-bottom: var(--spacing-lg);">
        <div class="search-container">
            <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" id="patient-search" class="form-input search-input" placeholder="Search by name, email or phone..." />
        </div>
    </div>

    <div id="alert-container" class="alert alert-danger" style="display: none;">
        <span id="alert-message"></span>
    </div>

    <div class="patient-table-wrapper">
        <table class="patient-table" id="patients-table">
            <thead>
                <tr>
                    <th>Patient Name</th>
                    <th>Age</th>
                    <th>Contact Details</th>
                    <th>Status</th>
                    <th style="width: 180px; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody id="patients-list-body">
                <tr>
                    <td colspan="5" style="text-align: center; color: var(--text-muted); padding: var(--spacing-xl) 0;">
                        <div class="spinner"></div>
                        Loading patients...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Glassmorphism Confirmation Modal -->
<div class="modal-overlay" id="delete-modal">
    <div class="modal-content-glass">
        <div style="color: var(--color-error); margin-bottom: var(--spacing-md);">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
        </div>
        <h3 style="color: var(--text-main); font-size: 1.3rem; font-weight: 600; margin-bottom: var(--spacing-sm);">Delete Patient Record?</h3>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: var(--spacing-lg);">
            Are you sure you want to permanently delete patient <strong id="delete-patient-name" style="color: var(--text-main);"></strong>? This will also remove all associated medical history records and cannot be undone.
        </p>
        <input type="hidden" id="delete-patient-id" />
        <div style="display: flex; gap: var(--spacing-md); justify-content: center;">
            <button class="btn-secondary" onclick="closeDeleteModal()">Cancel</button>
            <button class="btn-primary" id="btn-confirm-delete" onclick="confirmDeletePatient()" style="background: linear-gradient(135deg, var(--color-error) 0%, #B91C1C 100%); color: var(--text-main);">Delete Record</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            loadPatients();

            // Search filtering with debounce
            let searchTimeout;
            document.getElementById('patient-search').addEventListener('input', function(e) {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    loadPatients(e.target.value.trim());
                }, 300);
            });
        });

        function calculateAge(dobString) {
            if (!dobString) return '-';
            const dob = new Date(dobString);
            const today = new Date();
            let age = today.getFullYear() - dob.getFullYear();
            const monthDiff = today.getMonth() - dob.getMonth();
            if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < dob.getDate())) {
                age--;
            }
            return age >= 0 ? age : 0;
        }

        async function loadPatients(searchQuery = '') {
            const token = localStorage.getItem('token');
            const tbody = document.getElementById('patients-list-body');
            const alertContainer = document.getElementById('alert-container');
            const alertMessage = document.getElementById('alert-message');

            try {
                let url = '/api/patients';
                if (searchQuery) {
                    url += `?search=${encodeURIComponent(searchQuery)}`;
                }

                tbody.innerHTML = `
                    <tr>
                        <td colspan="5" style="text-align: center; color: var(--text-muted); padding: var(--spacing-xl) 0;">
                            <div class="spinner"></div>
                            Loading records...
                        </td>
                    </tr>
                `;

                const response = await fetch(url, {
                    method: 'GET',
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                if (response.status === 401) {
                    localStorage.removeItem('token');
                    localStorage.removeItem('user');
                    window.location.href = '/Account/Login';
                    return;
                }

                const result = await response.json();
                if (!response.ok || !result.success) {
                    throw new Error(result.message || 'Failed to fetch patients.');
                }

                tbody.innerHTML = '';
                const patients = result.data;

                if (patients.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="5" style="text-align: center; color: var(--text-muted); padding: 40px 0;">
                                <div style="font-size: 3rem; margin-bottom: var(--spacing-sm); color: var(--border-glass);">🔍</div>
                                <div style="font-weight: 500; font-size: 1.1rem; color: var(--text-main);">No Patient Records Found</div>
                                <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">Try searching for a different name, email, or contact number.</div>
                            </td>
                        </tr>
                    `;
                    return;
                }

                patients.forEach(patient => {
                    const age = calculateAge(patient.dateOfBirth);
                    
                    let statusClass = 'status-pending';
                    if (patient.status.toLowerCase() === 'active') statusClass = 'status-active';
                    if (patient.status.toLowerCase() === 'inactive') statusClass = 'status-inactive';

                    const nameInitials = patient.fullName
                        ? patient.fullName.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase()
                        : 'P';

                    tbody.innerHTML += `
                        <tr>
                            <td>
                                <div style="display: flex; align-items: center; gap: var(--spacing-md);">
                                    <div class="patient-avatar">
                                        ${nameInitials}
                                    </div>
                                    <div>
                                        <div style="font-weight: 600; color: var(--text-main); font-size: 1rem;">${patient.fullName}</div>
                                        <div style="font-size: 0.8rem; color: var(--text-muted);">ID: #${patient.id} | ${patient.gender.charAt(0).toUpperCase() + patient.gender.slice(1)}</div>
                                    </div>
                                </div>
                            </td>
                            <td style="vertical-align: middle;">${age} yrs</td>
                            <td style="vertical-align: middle;">
                                <div style="font-size: 0.9rem; color: var(--text-main);">${patient.phone}</div>
                                <div style="font-size: 0.8rem; color: var(--text-muted);">${patient.email}</div>
                            </td>
                            <td style="vertical-align: middle;">
                                <span class="status-badge ${statusClass}">${patient.status}</span>
                            </td>
                            <td style="vertical-align: middle; text-align: right;">
                                <div class="actions-cell" style="justify-content: flex-end;">
                                    <a href="/PatientView/Profile/${patient.id}" class="btn-icon btn-icon-edit" style="color: var(--color-primary); border-color: rgba(14, 237, 198, 0.2);" title="View Profile & Medical History">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"></path>
                                            <circle cx="12" cy="12" r="3"></circle>
                                        </svg>
                                    </a>
                                    <a href="/PatientView/Edit/${patient.id}" class="btn-icon btn-icon-edit" title="Edit Profile">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                            <path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                        </svg>
                                    </a>
                                    <button class="btn-icon btn-icon-delete" onclick="openDeleteModal(${patient.id}, '${patient.fullName.replace(/'/g, "\\'")}')" title="Delete Profile">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                            <line x1="10" y1="11" x2="10" y2="17"></line>
                                            <line x1="14" y1="11" x2="14" y2="17"></line>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `;
                });

            } catch (error) {
                alertContainer.style.display = 'block';
                alertMessage.innerText = error.message;
                tbody.innerHTML = `
                    <tr>
                        <td colspan="5" style="text-align: center; color: var(--color-error); padding: var(--spacing-xl) 0;">
                            Failed to load patient records.
                        </td>
                    </tr>
                `;
            }
        }

        function openDeleteModal(id, name) {
            document.getElementById('delete-patient-id').value = id;
            document.getElementById('delete-patient-name').innerText = name;
            const modal = document.getElementById('delete-modal');
            modal.classList.add('active');
        }

        function closeDeleteModal() {
            const modal = document.getElementById('delete-modal');
            modal.classList.remove('active');
        }

        async function confirmDeletePatient() {
            const id = document.getElementById('delete-patient-id').value;
            const token = localStorage.getItem('token');
            const deleteBtn = document.getElementById('btn-confirm-delete');
            const alertContainer = document.getElementById('alert-container');
            const alertMessage = document.getElementById('alert-message');

            const originalBtnText = deleteBtn.innerText;
            deleteBtn.disabled = true;
            deleteBtn.innerText = 'Deleting...';

            try {
                const response = await fetch(`/api/patients/${id}`, {
                    method: 'DELETE',
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                const result = await response.json();
                if (!response.ok || !result.success) {
                    throw new Error(result.message || 'Failed to delete patient record.');
                }

                closeDeleteModal();
                loadPatients(document.getElementById('patient-search').value.trim());

            } catch (error) {
                closeDeleteModal();
                alertContainer.style.display = 'block';
                alertMessage.innerText = error.message;
            } finally {
                deleteBtn.disabled = false;
                deleteBtn.innerText = originalBtnText;
            }
        }
    </script>
}
