@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

<!-- Inline script in head/body start to prevent flash of unauthenticated content -->
<script>
    if (!localStorage.getItem('token')) {
        window.location.href = '/Account/Login';
    }
</script>

<div class="container animate-fade-in" style="padding: var(--spacing-xl) 0;">
    <div style="display: flex; flex-direction: column; gap: var(--spacing-xl);">
        
        <!-- Welcome Hero Banner -->
        <div class="glass-card" style="background: linear-gradient(135deg, rgba(13, 21, 39, 0.7) 0%, rgba(139, 92, 246, 0.1) 100%); border-color: rgba(139, 92, 246, 0.15);">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--spacing-md);">
                <div>
                    <h1 style="font-size: 2.5rem; font-weight: 700; margin-bottom: var(--spacing-xs); background: linear-gradient(135deg, var(--text-main) 50%, var(--color-primary) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                        Welcome Back, <span id="display-username">User</span>!
                    </h1>
                    <p style="color: var(--text-muted); font-size: 1.1rem;">Healthcare CRM Client Portal</p>
                </div>
                <div style="display: flex; gap: var(--spacing-sm);">
                    <span id="display-role" style="padding: 6px 16px; background: rgba(14, 237, 198, 0.1); border: 1px solid var(--color-primary); border-radius: 50px; color: var(--color-primary); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">
                        Patient
                    </span>
                </div>
            </div>
        </div>

        <!-- Dashboard Cards Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--spacing-lg);">
            
            <!-- Profile Info Card -->
            <div class="glass-card">
                <div style="display: flex; align-items: center; gap: var(--spacing-md); margin-bottom: var(--spacing-lg);">
                    <div style="background: rgba(139, 92, 246, 0.1); border: 1.5px solid var(--color-accent); width: 50px; height: 50px; border-radius: 50%; display: flex; justify-content: center; align-items: center; color: var(--color-accent);">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </div>
                    <div>
                        <h3 style="font-size: 1.25rem; font-weight: 600;">User Session</h3>
                        <p style="color: var(--text-muted); font-size: 0.85rem;">Account details</p>
                    </div>
                </div>
                
                <div style="display: flex; flex-direction: column; gap: var(--spacing-md); font-size: 0.95rem;">
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-glass); padding-bottom: var(--spacing-sm);">
                        <span style="color: var(--text-muted);">Email:</span>
                        <span id="display-email" style="font-weight: 500;">-</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-glass); padding-bottom: var(--spacing-sm);">
                        <span style="color: var(--text-muted);">Status:</span>
                        <span style="color: var(--color-success); font-weight: 600; display: flex; align-items: center; gap: 4px;">
                            <span style="width: 8px; height: 8px; background-color: var(--color-success); border-radius: 50%; display: inline-block;"></span>
                            Authenticated
                        </span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: var(--text-muted);">JWT Active:</span>
                        <span style="color: var(--color-primary); font-weight: 500; font-family: monospace;">Local Storage</span>
                    </div>
                </div>
            </div>

            <!-- Quick Actions Card -->
            <div class="glass-card">
                <div style="display: flex; align-items: center; gap: var(--spacing-md); margin-bottom: var(--spacing-lg);">
                    <div style="background: rgba(14, 237, 198, 0.1); border: 1.5px solid var(--color-primary); width: 50px; height: 50px; border-radius: 50%; display: flex; justify-content: center; align-items: center; color: var(--color-primary);">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                    </div>
                    <div>
                        <h3 style="font-size: 1.25rem; font-weight: 600;">CRM Navigation</h3>
                        <p style="color: var(--text-muted); font-size: 0.85rem;">Week 1 Scaffolding</p>
                    </div>
                </div>

                <div style="display: flex; flex-direction: column; gap: var(--spacing-sm);">
                    <a href="/swagger" class="btn-secondary" style="display: block; text-align: center; font-weight: 500;">
                        Open API Swagger Docs
                    </a>
                    <a href="/Account/Logout" class="btn-primary" style="display: block; text-align: center; font-weight: 600;">
                        Sign Out / Clear Token
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Load user info from localStorage
        const userStr = localStorage.getItem('user');
        if (userStr) {
            try {
                const user = JSON.parse(userStr);
                document.getElementById('display-username').innerText = user.username || 'User';
                document.getElementById('display-email').innerText = user.email || '-';
                document.getElementById('display-role').innerText = user.role || 'Patient';
            } catch (e) {
                console.error("Error parsing user from localStorage:", e);
            }
        }
    </script>
}
