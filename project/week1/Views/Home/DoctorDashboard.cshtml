@{
    ViewData["Title"] = "Doctor Dashboard";
    Layout = "_Layout";
}

<!-- Client-side role enforcement backup -->
<script>
    const userStr = localStorage.getItem('user');
    if (!localStorage.getItem('token')) {
        window.location.href = '/Account/Login';
    } else if (userStr) {
        try {
            const user = JSON.parse(userStr);
            if (user.role !== 'Doctor') {
                window.location.href = '/Account/UnauthorizedPage';
            }
        } catch (e) {
            console.error("Error parsing user info:", e);
        }
    }
</script>

<div class="container animate-fade-in" style="padding: var(--spacing-xl) 0;">
    <div style="display: flex; flex-direction: column; gap: var(--spacing-xl);">
        
        <!-- Welcome Hero Banner -->
        <div class="glass-card" style="background: linear-gradient(135deg, rgba(13, 21, 39, 0.7) 0%, rgba(14, 237, 198, 0.05) 100%); border-color: rgba(14, 237, 198, 0.25);">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--spacing-md);">
                <div>
                    <h1 style="font-size: 2.2rem; font-weight: 700; margin-bottom: var(--spacing-xs); background: linear-gradient(135deg, var(--text-main) 50%, var(--color-primary) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                        Clinical Overview
                    </h1>
                    <p style="color: var(--text-muted); font-size: 1.1rem;">Welcome back, <span id="doctor-name" style="color: var(--text-main); font-weight: 600;">Doctor</span></p>
                </div>
                <div style="display: flex; gap: var(--spacing-sm);">
                    <span style="padding: 6px 16px; background: rgba(14, 237, 198, 0.15); border: 1px solid var(--color-primary); border-radius: 50px; color: var(--color-primary); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; box-shadow: 0 0 15px rgba(14, 237, 198, 0.25);">
                        Medical Staff
                    </span>
                </div>
            </div>
        </div>

        <!-- Clinical Stats Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--spacing-lg);">
            
            <div class="glass-card" style="padding: var(--spacing-lg); border-left: 3px solid var(--color-primary);">
                <p style="font-size: 0.85rem; text-transform: uppercase; color: var(--text-muted); letter-spacing: 1px;">Appointments Today</p>
                <h3 style="font-size: 1.8rem; margin: var(--spacing-xs) 0; color: var(--color-primary);">6</h3>
                <p style="font-size: 0.8rem; color: var(--text-muted);">Next in 15 mins</p>
            </div>

            <div class="glass-card" style="padding: var(--spacing-lg); border-left: 3px solid var(--color-accent);">
                <p style="font-size: 0.85rem; text-transform: uppercase; color: var(--text-muted); letter-spacing: 1px;">Assigned Patients</p>
                <h3 style="font-size: 1.8rem; margin: var(--spacing-xs) 0; color: var(--text-main);">42</h3>
                <p style="font-size: 0.8rem; color: var(--color-primary);">4 new this week</p>
            </div>

            <div class="glass-card" style="padding: var(--spacing-lg); border-left: 3px solid var(--color-success);">
                <p style="font-size: 0.85rem; text-transform: uppercase; color: var(--text-muted); letter-spacing: 1px;">Completed Visits</p>
                <h3 style="font-size: 1.8rem; margin: var(--spacing-xs) 0; color: var(--color-success);">3</h3>
                <p style="font-size: 0.8rem; color: var(--text-muted);">Out of 9 total scheduled</p>
            </div>

            <div class="glass-card" style="padding: var(--spacing-lg); border-left: 3px solid var(--color-error);">
                <p style="font-size: 0.85rem; text-transform: uppercase; color: var(--text-muted); letter-spacing: 1px;">Pending EHR Signatures</p>
                <h3 style="font-size: 1.8rem; margin: var(--spacing-xs) 0; color: var(--color-error);">2</h3>
                <p style="font-size: 0.8rem; color: var(--color-error);">Require prompt signoff</p>
            </div>

        </div>

        <!-- Clinical Panel Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: var(--spacing-lg);">
            
            <!-- Quick Actions -->
            <div class="glass-card">
                <div style="display: flex; align-items: center; gap: var(--spacing-md); margin-bottom: var(--spacing-lg);">
                    <div style="background: rgba(14, 237, 198, 0.1); border: 1.5px solid var(--color-primary); width: 45px; height: 45px; border-radius: 12px; display: flex; justify-content: center; align-items: center; color: var(--color-primary);">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                        </svg>
                    </div>
                    <div>
                        <h3 style="font-size: 1.2rem; font-weight: 600;">Clinical Actions</h3>
                        <p style="color: var(--text-muted); font-size: 0.85rem;">Patient and medical tools</p>
                    </div>
                </div>

                <div style="display: flex; flex-direction: column; gap: var(--spacing-sm);">
                    <a href="/PatientView" class="btn-primary" style="text-align: center; text-decoration: none; display: block; font-weight: 600;">
                        Open Patient Registry
                    </a>
                    <button class="btn-secondary" onclick="alert('Redirecting to Scheduling (Under Construction)...')" style="width: 100%;">
                        View Full Schedule
                    </button>
                    <button class="btn-secondary" onclick="alert('EHR system initialized.')" style="width: 100%;">
                        Access Prescriptions (EHR)
                    </button>
                </div>
            </div>

            <!-- Patient Check-in Feed -->
            <div class="glass-card">
                <div style="display: flex; align-items: center; gap: var(--spacing-md); margin-bottom: var(--spacing-lg);">
                    <div style="background: rgba(139, 92, 246, 0.1); border: 1.5px solid var(--color-accent); width: 45px; height: 45px; border-radius: 12px; display: flex; justify-content: center; align-items: center; color: var(--color-accent);">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                    <div>
                        <h3 style="font-size: 1.2rem; font-weight: 600;">Recent Check-ins</h3>
                        <p style="color: var(--text-muted); font-size: 0.85rem;">Patients in waiting room</p>
                    </div>
                </div>

                <div style="display: flex; flex-direction: column; gap: var(--spacing-md); font-size: 0.95rem;">
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-glass); padding-bottom: var(--spacing-xs);">
                        <span style="font-weight: 500;">Alice Smith</span>
                        <span style="color: var(--color-primary);">Checked In (10:15)</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-glass); padding-bottom: var(--spacing-xs);">
                        <span style="font-weight: 500;">Bob Jones</span>
                        <span style="color: var(--color-primary);">In Progress (10:30)</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-glass); padding-bottom: var(--spacing-xs);">
                        <span style="font-weight: 500;">Charlie Brown</span>
                        <span style="color: var(--text-muted);">Scheduled (11:00)</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Load doctor name dynamically from localStorage
        if (userStr) {
            try {
                const user = JSON.parse(userStr);
                if (user.fullName) {
                    document.getElementById('doctor-name').innerText = "Dr. " + user.fullName;
                }
            } catch (e) {
                console.error("Error setting doctor name:", e);
            }
        }
    </script>
}
