@{
    ViewData["Title"] = "Add Patient";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/patient.css" asp-append-version="true" />
}

<script>
    if (!localStorage.getItem('token')) {
        window.location.href = '/Account/Login';
    }
</script>

<div class="container patient-container animate-fade-in" style="max-width: 800px;">
    <div style="margin-bottom: var(--spacing-xl);">
        <a href="/PatientView" style="color: var(--color-primary); text-decoration: none; display: inline-flex; align-items: center; gap: var(--spacing-sm); font-size: 0.95rem; font-weight: 500;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Back to Directory
        </a>
        <h1 style="font-size: 2.2rem; font-weight: 700; background: linear-gradient(135deg, var(--text-main) 30%, var(--color-primary) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-top: var(--spacing-sm);">
            Add Patient Record
        </h1>
        <p style="color: var(--text-muted); font-size: 0.95rem;">Register a new patient profile into the CRM database.</p>
    </div>

    <div id="alert-container" class="alert alert-danger" style="display: none;">
        <span id="alert-message"></span>
    </div>

    <div class="glass-card">
        <form id="add-patient-form" novalidate>
            <div class="form-grid">
                <div class="form-group">
                    <label for="firstName" class="form-label">First Name</label>
                    <input type="text" id="firstName" class="form-input" placeholder="e.g. John" required />
                    <div id="firstName-error" class="input-error-msg">First name is required.</div>
                </div>

                <div class="form-group">
                    <label for="lastName" class="form-label">Last Name</label>
                    <input type="text" id="lastName" class="form-input" placeholder="e.g. Doe" required />
                    <div id="lastName-error" class="input-error-msg">Last name is required.</div>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label for="email" class="form-label">Email Address</label>
                    <input type="email" id="email" class="form-input" placeholder="e.g. john.doe@example.com" required />
                    <div id="email-error" class="input-error-msg">Please enter a valid email address.</div>
                </div>

                <div class="form-group">
                    <label for="phoneNumber" class="form-label">Phone Number</label>
                    <input type="text" id="phoneNumber" class="form-input" placeholder="e.g. +923001234567" required />
                    <div id="phoneNumber-error" class="input-error-msg">Phone number is required.</div>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label for="dateOfBirth" class="form-label">Date of Birth</label>
                    <input type="date" id="dateOfBirth" class="form-input" required />
                    <div id="dateOfBirth-error" class="input-error-msg">Date of birth is required.</div>
                </div>

                <div class="form-group">
                    <label for="gender" class="form-label">Gender</label>
                    <select id="gender" class="form-input" style="height: 48px;" required>
                        <option value="" disabled selected>Select Gender</option>
                        <option value="male">Male</option>
                        <option value="female">Female</option>
                        <option value="other">Other</option>
                    </select>
                    <div id="gender-error" class="input-error-msg">Gender is required.</div>
                </div>
            </div>

            <div class="form-group">
                <label for="address" class="form-label">Residential Address</label>
                <input type="text" id="address" class="form-input" placeholder="e.g. House 123, Sector G-10, Islamabad" />
            </div>

            <button type="submit" class="btn-primary" style="width: 100%; margin-top: var(--spacing-sm);">
                Save Patient Record
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('add-patient-form').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const firstNameInput = document.getElementById('firstName');
            const lastNameInput = document.getElementById('lastName');
            const emailInput = document.getElementById('email');
            const phoneNumberInput = document.getElementById('phoneNumber');
            const dobInput = document.getElementById('dateOfBirth');
            const genderInput = document.getElementById('gender');
            const addressInput = document.getElementById('address');

            const firstNameError = document.getElementById('firstName-error');
            const lastNameError = document.getElementById('lastName-error');
            const emailError = document.getElementById('email-error');
            const phoneNumberError = document.getElementById('phoneNumber-error');
            const dobError = document.getElementById('dateOfBirth-error');
            const genderError = document.getElementById('gender-error');
            const alertContainer = document.getElementById('alert-container');
            const alertMessage = document.getElementById('alert-message');

            // Reset
            alertContainer.style.display = 'none';
            [firstNameInput, lastNameInput, emailInput, phoneNumberInput, dobInput, genderInput].forEach(el => el.classList.remove('invalid'));
            [firstNameError, lastNameError, emailError, phoneNumberError, dobError, genderError].forEach(el => el.style.display = 'none');

            let isValid = true;

            if (!firstNameInput.value.trim()) {
                firstNameInput.classList.add('invalid');
                firstNameError.style.display = 'block';
                isValid = false;
            }

            if (!lastNameInput.value.trim()) {
                lastNameInput.classList.add('invalid');
                lastNameError.style.display = 'block';
                isValid = false;
            }

            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            if (!emailRegex.test(emailInput.value.trim())) {
                emailInput.classList.add('invalid');
                emailError.style.display = 'block';
                isValid = false;
            }

            if (!phoneNumberInput.value.trim()) {
                phoneNumberInput.classList.add('invalid');
                phoneNumberError.style.display = 'block';
                isValid = false;
            }

            if (!dobInput.value) {
                dobInput.classList.add('invalid');
                dobError.style.display = 'block';
                isValid = false;
            }

            if (!genderInput.value) {
                genderInput.classList.add('invalid');
                genderError.style.display = 'block';
                isValid = false;
            }

            if (!isValid) return;

            const submitBtn = e.target.querySelector('button[type="submit"]');
            const originalBtnText = submitBtn.innerText;
            submitBtn.disabled = true;
            submitBtn.innerText = 'Saving Record...';

            try {
                const token = localStorage.getItem('token');
                const response = await fetch('/api/patients', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({
                        firstName: firstNameInput.value.trim(),
                        lastName: lastNameInput.value.trim(),
                        email: emailInput.value.trim(),
                        phoneNumber: phoneNumberInput.value.trim(),
                        dateOfBirth: dobInput.value,
                        gender: genderInput.value,
                        address: addressInput.value.trim()
                    })
                });

                const result = await response.json();

                if (!response.ok || !result.success) {
                    throw new Error(result.message || 'Failed to save patient.');
                }

                // Temporary success state
                alertContainer.className = "alert alert-success";
                alertMessage.innerText = "Patient record created successfully! Redirecting...";
                alertContainer.style.display = 'flex';

                setTimeout(() => {
                    window.location.href = '/PatientView';
                }, 1000);

            } catch (error) {
                alertContainer.className = "alert alert-danger";
                alertMessage.innerText = error.message;
                alertContainer.style.display = 'flex';
                submitBtn.disabled = false;
                submitBtn.innerText = originalBtnText;
            }
        });
    </script>
}
