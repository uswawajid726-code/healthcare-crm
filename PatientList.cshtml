@page
@model PatientListModel
@{
    ViewData["Title"] = "Patient List";
    Layout = "_Layout";
}

<div class="container mt-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Patients</h2>
        <a asp-page="AddEditPatient" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add Patient
        </a>
    </div>

    <!-- Search Bar -->
    <div class="mb-4">
        <form method="get" id="searchForm">
            <div class="input-group" style="max-width: 420px;">
                <span class="input-group-text bg-white">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text"
                       name="search"
                       id="searchInput"
                       class="form-control border-start-0"
                       placeholder="Search by name, CNIC, or phone..."
                       value="@Model.SearchQuery"
                       autocomplete="off" />
                @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                {
                    <a asp-page="PatientList" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </form>
    </div>

    <!-- Loading State -->
    <div id="loadingState" class="text-center py-5" style="display:none !important;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading patients...</span>
        </div>
        <p class="text-muted mt-2">Loading patients...</p>
    </div>

    <!-- Empty State — No patients exist at all -->
    @if (Model.Patients == null || !Model.Patients.Any())
    {
        if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
        {
            <!-- Empty State — Search returned no results -->
            <div class="text-center py-5" id="emptySearch">
                <i class="bi bi-search" style="font-size: 3rem; color: #ccc;"></i>
                <h5 class="mt-3 text-muted">No results for "@Model.SearchQuery"</h5>
                <p class="text-muted">Try a different name, CNIC, or phone number.</p>
                <a asp-page="PatientList" class="btn btn-outline-primary mt-2">Clear search</a>
            </div>
        }
        else
        {
            <div class="text-center py-5" id="emptyState">
                <i class="bi bi-people" style="font-size: 3rem; color: #ccc;"></i>
                <h5 class="mt-3 text-muted">No patients yet</h5>
                <p class="text-muted">Add your first patient to get started.</p>
                <a asp-page="AddEditPatient" class="btn btn-primary mt-2">
                    <i class="bi bi-plus-lg"></i> Add Patient
                </a>
            </div>
        }
    }
    else
    {
        <!-- Patient Table -->
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Full Name</th>
                        <th>CNIC</th>
                        <th>Phone</th>
                        <th>Date of Birth</th>
                        <th>Gender</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (patient, index) in Model.Patients.Select((p, i) => (p, i + 1)))
                    {
                        <tr>
                            <td class="text-muted">@index</td>
                            <td>
                                <strong>@patient.FullName</strong>
                            </td>
                            <td>@patient.Cnic</td>
                            <td>@patient.Phone</td>
                            <td>@patient.DateOfBirth.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="badge @(patient.Gender == "Male" ? "bg-primary-subtle text-primary-emphasis" : "bg-pink-subtle text-pink-emphasis")">
                                    @patient.Gender
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-page="AddEditPatient"
                                   asp-route-id="@patient.PatientId"
                                   class="btn btn-sm btn-outline-secondary me-1"
                                   title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        title="Delete"
                                        onclick="confirmDelete(@patient.PatientId, '@patient.FullName')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Result count -->
        <p class="text-muted small mt-2">
            Showing @Model.Patients.Count patient(s)
            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
            {
                <span>for "@Model.SearchQuery"</span>
            }
        </p>
    }
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete <strong id="deletePatientName"></strong>? This action cannot be undone.
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-page-handler="Delete" id="deleteForm">
                    <input type="hidden" name="id" id="deletePatientId" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Show loading state while search form submits
        document.getElementById('searchForm').addEventListener('submit', function () {
            document.getElementById('loadingState').style.removeProperty('display');
        });

        // Live search with debounce
        let debounceTimer;
        document.getElementById('searchInput').addEventListener('input', function () {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => {
                document.getElementById('searchForm').submit();
            }, 400);
        });

        // Delete modal
        function confirmDelete(id, name) {
            document.getElementById('deletePatientId').value = id;
            document.getElementById('deletePatientName').textContent = name;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
}
