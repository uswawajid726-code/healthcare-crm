@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="auth-container">
    <div class="auth-card glass-card text-center animate-fade-in" style="max-width: 500px;">
        <div style="background: rgba(239, 68, 68, 0.1); border: 2px solid var(--color-error); width: 80px; height: 80px; border-radius: 50%; display: flex; justify-content: center; align-items: center; color: var(--color-error); margin: 0 auto var(--spacing-lg) auto;">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
        </div>
        
        <h1 class="auth-title" style="color: var(--color-error); background: none; -webkit-text-fill-color: initial;">
            Access Denied
        </h1>
        
        <p class="auth-subtitle mb-4 mt-2" style="font-size: 1.05rem;">
            Your account does not have permission to access this page.
        </p>
        
        <a href="/Home/Index" class="btn-primary w-100" style="text-decoration: none;">
            Return to Dashboard
        </a>
    </div>
</div>
