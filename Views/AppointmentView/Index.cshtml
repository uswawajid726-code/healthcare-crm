@{
    ViewData["Title"] = "Appointments";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/patient.css" asp-append-version="true" />
    <style>
        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .status-scheduled {
            background: rgba(139, 92, 246, 0.1);
            border: 1px solid rgba(139, 92, 246, 0.3);
            color: #C7D2FE;
        }
        .status-completed {
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.3);
            color: #A7F3D0;
        }
        .status-cancelled {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #FCA5A5;
        }

        /* Modal Glassmorphism */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(7, 11, 19, 0.7);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        .modal-overlay.active {
            display: flex;
            opacity: 1;
        }
        .modal-content-glass {
            max-width: 480px;
            width: 90%;
            background: rgba(13, 21, 39, 0.85);
            border: 1px solid var(--border-glass);
            box-shadow: 0 16px 40px rgba(0,0,0,0.5);
            border-radius: var(--border-radius-md);
            padding: var(--spacing-lg);
            transform: scale(0.9);
            transition: transform 0.3s ease;
            text-align: center;
        }
        .modal-overlay.active .modal-content-glass {
            transform: scale(1);
        }

        .spinner {
            border: 3px solid rgba(255,255,255,0.05);
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border-left-color: var(--color-primary);
            animation: spin 1s linear infinite;
            margin: var(--spacing-lg) auto;
        }
        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .filter-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr;
            gap: var(--spacing-md);
        }
        @@media (max-width: 768px) {
            .filter-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<!-- Client-side authentication check -->
<script>
    if (!localStorage.getItem('token')) {
        window.location.href = '/Account/Login';
    }
</script>

<div class="container patient-container animate-fade-in">
    <div class="patient-top-bar">
        <div>
            <h1 style="font-size: 2.2rem; font-weight: 700; background: linear-gradient(135deg, var(--text-main) 30%, var(--color-primary) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                Appointment Management
            </h1>
            <p style="color: var(--text-muted); font-size: 0.95rem;">View, schedule, and organize patient consultations.</p>
        </div>
        
        <a href="/AppointmentView/Create" id="btn-create-appointment" class="btn-primary" style="text-decoration: none; display: none;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: var(--spacing-sm);">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Schedule Appointment
        </a>
    </div>

    <!-- Filters Panel -->
    <div class="glass-card" style="padding: var(--spacing-lg); margin-bottom: var(--spacing-lg);">
        <div class="filter-grid">
            <div class="search-container" style="max-width: none;">
                <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" id="appointment-search" class="form-input search-input" placeholder="Search by patient or doctor name..." />
            </div>

            <div>
                <input type="date" id="filter-date" class="form-input" placeholder="Filter by date" style="height: 48px;" />
            </div>

            <div>
                <select id="filter-status" class="form-input" style="height: 48px;">
                    <option value="">All Statuses</option>
                    <option value="Scheduled">Scheduled</option>
                    <option value="Completed">Completed</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
            </div>
        </div>
        <div style="margin-top: 12px; display: flex; justify-content: flex-end;">
            <button class="btn-secondary" id="btn-clear-filters" style="font-size: 0.85rem; padding: 6px 14px;">Clear Filters</button>
        </div>
    </div>

    <div id="alert-container" class="alert alert-danger" style="display: none;">
        <span id="alert-message"></span>
    </div>

    <!-- Table Wrapper -->
    <div class="patient-table-wrapper">
        <table class="patient-table" id="appointments-table">
            <thead>
                <tr>
                    <th>Appointment ID</th>
                    <th>Patient Name</th>
                    <th>Doctor Name</th>
                    <th>Date & Time</th>
                    <th>Status</th>
                    <th style="width: 180px; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody id="appointments-list-body">
                <tr>
                    <td colspan="6" style="text-align: center; color: var(--text-muted); padding: var(--spacing-xl) 0;">
                        <div class="spinner"></div>
                        Loading appointments...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Glassmorphism Cancel/Delete Confirmation Modal -->
<div class="modal-overlay" id="delete-modal">
    <div class="modal-content-glass">
        <div style="color: var(--color-error); margin-bottom: var(--spacing-md);">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
        </div>
        <h3 style="color: var(--text-main); font-size: 1.3rem; font-weight: 600; margin-bottom: var(--spacing-sm);">Cancel Appointment?</h3>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: var(--spacing-lg);">
            Are you sure you want to cancel appointment <strong id="delete-appt-id" style="color: var(--text-main);"></strong>? This will permanently delete the scheduling record and cannot be undone.
        </p>
        <input type="hidden" id="delete-appt-raw-id" />
        <div style="display: flex; gap: var(--spacing-md); justify-content: center;">
            <button class="btn-secondary" onclick="closeDeleteModal()">Go Back</button>
            <button class="btn-primary" id="btn-confirm-delete" onclick="confirmDeleteAppointment()" style="background: linear-gradient(135deg, var(--color-error) 0%, #B91C1C 100%); color: var(--text-main);">Cancel Appointment</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const user = JSON.parse(localStorage.getItem('user') || '{}');
        const token = localStorage.getItem('token');
        const userRole = user.role;

        document.addEventListener('DOMContentLoaded', function() {
            // Show Create button only for Admin and Receptionist
            if (userRole === 'Admin' || userRole === 'Receptionist') {
                document.getElementById('btn-create-appointment').style.display = 'inline-flex';
            }

            loadAppointments();

            // Set up search, date, and status inputs listeners
            let filterTimeout;
            const searchInput = document.getElementById('appointment-search');
            const dateInput = document.getElementById('filter-date');
            const statusSelect = document.getElementById('filter-status');

            const onFilterChanged = () => {
                clearTimeout(filterTimeout);
                filterTimeout = setTimeout(() => {
                    loadAppointments(
                        searchInput.value.trim(),
                        statusSelect.value,
                        dateInput.value
                    );
                }, 300);
            };

            searchInput.addEventListener('input', onFilterChanged);
            dateInput.addEventListener('change', onFilterChanged);
            statusSelect.addEventListener('change', onFilterChanged);

            document.getElementById('btn-clear-filters').addEventListener('click', function() {
                searchInput.value = '';
                dateInput.value = '';
                statusSelect.value = '';
                loadAppointments();
            });
        });

        async function loadAppointments(search = '', status = '', date = '') {
            const tbody = document.getElementById('appointments-list-body');
            const alertContainer = document.getElementById('alert-container');
            const alertMessage = document.getElementById('alert-message');

            try {
                let url = '/api/appointments';
                const params = [];
                if (search) params.push(`search=${encodeURIComponent(search)}`);
                if (status) params.push(`status=${encodeURIComponent(status)}`);
                if (date) params.push(`date=${encodeURIComponent(date)}`);
                
                if (params.length > 0) {
                    url += `?${params.join('&')}`;
                }

                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" style="text-align: center; color: var(--text-muted); padding: var(--spacing-xl) 0;">
                            <div class="spinner"></div>
                            Loading records...
                        </td>
                    </tr>
                `;

                const response = await fetch(url, {
                    method: 'GET',
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                if (response.status === 401) {
                    localStorage.removeItem('token');
                    localStorage.removeItem('user');
                    window.location.href = '/Account/Login';
                    return;
                }

                const result = await response.json();
                if (!response.ok || !result.success) {
                    throw new Error(result.message || 'Failed to fetch appointments.');
                }

                tbody.innerHTML = '';
                const appts = result.data;

                if (appts.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 40px 0;">
                                <div style="font-size: 3rem; margin-bottom: var(--spacing-sm); color: var(--border-glass);">📅</div>
                                <div style="font-weight: 500; font-size: 1.1rem; color: var(--text-main);">No appointments found.</div>
                                <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">Try modifying your search or filter selections.</div>
                            </td>
                        </tr>
                    `;
                    return;
                }

                appts.forEach(appt => {
                    const formattedDate = new Date(appt.appointmentDate).toLocaleDateString(undefined, {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                    });

                    let statusClass = 'status-scheduled';
                    if (appt.status.toLowerCase() === 'completed') statusClass = 'status-completed';
                    if (appt.status.toLowerCase() === 'cancelled') statusClass = 'status-cancelled';

                    const isEditable = userRole === 'Admin' || userRole === 'Receptionist';

                    tbody.innerHTML += `
                        <tr>
                            <td style="vertical-align: middle; font-weight: 600; color: var(--color-primary);">#APT-${appt.id}</td>
                            <td style="vertical-align: middle;">
                                <div style="font-weight: 600; color: var(--text-main);">${appt.patient ? appt.patient.fullName : 'Unknown'}</div>
                                <div style="font-size: 0.75rem; color: var(--text-muted);">Patient ID: #${appt.patientId}</div>
                            </td>
                            <td style="vertical-align: middle;">
                                <div style="font-weight: 500; color: var(--text-main);">${appt.doctor ? appt.doctor.fullName : 'Unknown'}</div>
                            </td>
                            <td style="vertical-align: middle;">
                                <div style="font-size: 0.9rem; color: var(--text-main);">${formattedDate}</div>
                                <div style="font-size: 0.8rem; color: var(--text-muted); font-weight: 500;">⏱ ${appt.appointmentTime}</div>
                            </td>
                            <td style="vertical-align: middle;">
                                <span class="status-badge ${statusClass}">${appt.status}</span>
                            </td>
                            <td style="vertical-align: middle; text-align: right;">
                                <div class="actions-cell" style="justify-content: flex-end;">
                                    <a href="/AppointmentView/Details/${appt.id}" class="btn-icon btn-icon-edit" style="color: var(--color-primary); border-color: rgba(14, 237, 198, 0.2);" title="View Details">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                            <circle cx="12" cy="12" r="3"></circle>
                                        </svg>
                                    </a>
                                    ${isEditable ? `
                                    <a href="/AppointmentView/Edit/${appt.id}" class="btn-icon btn-icon-edit" title="Edit Appointment">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                            <path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                        </svg>
                                    </a>
                                    <button class="btn-icon btn-icon-delete" onclick="openDeleteModal(${appt.id})" title="Cancel Appointment">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                            <line x1="10" y1="11" x2="10" y2="17"></line>
                                            <line x1="14" y1="11" x2="14" y2="17"></line>
                                        </svg>
                                    </button>
                                    ` : ''}
                                </div>
                            </td>
                        </tr>
                    `;
                });

            } catch (error) {
                alertContainer.style.display = 'block';
                alertMessage.innerText = error.message;
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" style="text-align: center; color: var(--color-error); padding: var(--spacing-xl) 0;">
                            Failed to load appointment records.
                        </td>
                    </tr>
                `;
            }
        }

        function openDeleteModal(id) {
            document.getElementById('delete-appt-raw-id').value = id;
            document.getElementById('delete-appt-id').innerText = `#APT-${id}`;
            const modal = document.getElementById('delete-modal');
            modal.classList.add('active');
        }

        function closeDeleteModal() {
            const modal = document.getElementById('delete-modal');
            modal.classList.remove('active');
        }

        async function confirmDeleteAppointment() {
            const id = document.getElementById('delete-appt-raw-id').value;
            const deleteBtn = document.getElementById('btn-confirm-delete');
            const alertContainer = document.getElementById('alert-container');
            const alertMessage = document.getElementById('alert-message');

            const originalBtnText = deleteBtn.innerText;
            deleteBtn.disabled = true;
            deleteBtn.innerText = 'Cancelling...';

            try {
                const response = await fetch(`/api/appointments/${id}`, {
                    method: 'DELETE',
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                const result = await response.json();
                if (!response.ok || !result.success) {
                    throw new Error(result.message || 'Failed to cancel appointment.');
                }

                closeDeleteModal();
                loadAppointments(
                    document.getElementById('appointment-search').value.trim(),
                    document.getElementById('filter-status').value,
                    document.getElementById('filter-date').value
                );

            } catch (error) {
                closeDeleteModal();
                alertContainer.style.display = 'block';
                alertMessage.innerText = error.message;
            } finally {
                deleteBtn.disabled = false;
                deleteBtn.innerText = originalBtnText;
            }
        }
    </script>
}
