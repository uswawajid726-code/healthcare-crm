@{
    ViewData["Title"] = "Patient Profile";
    Layout = "_Layout";
    var patientId = ViewBag.PatientId;
}

@section Styles {
    <link rel="stylesheet" href="~/css/patient.css" asp-append-version="true" />
    <style>
        .profile-grid {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: var(--spacing-lg);
            margin-top: var(--spacing-md);
        }
        
        .patient-info-sidebar {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-md);
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            border-bottom: 1px solid var(--border-glass);
            padding: var(--spacing-sm) 0;
            font-size: 0.95rem;
        }

        .info-row:last-child {
            border-bottom: none;
        }

        .info-label {
            color: var(--text-muted);
            font-weight: 500;
        }

        .info-value {
            color: var(--text-main);
            font-weight: 600;
        }

        .history-timeline {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-md);
            margin-top: var(--spacing-md);
            max-height: 480px;
            overflow-y: auto;
            padding-right: var(--spacing-sm);
        }

        .history-card {
            background: rgba(13, 21, 39, 0.4);
            border: 1px solid var(--border-glass);
            border-radius: var(--border-radius-sm);
            padding: var(--spacing-md);
            position: relative;
            transition: var(--transition-fast);
        }

        .history-card:hover {
            border-color: rgba(139, 92, 246, 0.2);
            background: rgba(13, 21, 39, 0.6);
        }

        .history-date {
            font-size: 0.8rem;
            color: var(--color-accent);
            font-weight: 600;
            margin-bottom: 4px;
        }

        .history-diagnosis {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--text-main);
            margin-bottom: 6px;
        }

        .history-notes {
            font-size: 0.9rem;
            color: var(--text-muted);
            line-height: 1.4;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .status-active {
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.3);
            color: #A7F3D0;
        }
        .status-inactive {
            background: rgba(148, 163, 184, 0.1);
            border: 1px solid rgba(148, 163, 184, 0.3);
            color: #E2E8F0;
        }
        .status-pending {
            background: rgba(139, 92, 246, 0.1);
            border: 1px solid rgba(139, 92, 246, 0.3);
            color: #C7D2FE;
        }

        .spinner {
            border: 3px solid rgba(255,255,255,0.05);
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border-left-color: var(--color-primary);
            animation: spin 1s linear infinite;
            margin: var(--spacing-lg) auto;
        }
        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        @@media (max-width: 768px) {
            .profile-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<script>
    if (!localStorage.getItem('token')) {
        window.location.href = '/Account/Login';
    }
</script>

<div class="container patient-container animate-fade-in">
    <div style="margin-bottom: var(--spacing-xl);">
        <a href="/PatientView" style="color: var(--color-primary); text-decoration: none; display: inline-flex; align-items: center; gap: var(--spacing-sm); font-size: 0.95rem; font-weight: 500;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Back to Directory
        </a>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: var(--spacing-sm); flex-wrap: wrap; gap: var(--spacing-md);">
            <div>
                <h1 id="profile-title-name" style="font-size: 2.2rem; font-weight: 700; background: linear-gradient(135deg, var(--text-main) 30%, var(--color-primary) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                    Loading Patient...
                </h1>
                <p style="color: var(--text-muted); font-size: 0.95rem;">Full profile record and diagnostic history.</p>
            </div>
            <div>
                <a id="btn-edit-profile" href="#" class="btn-secondary" style="text-decoration: none;">
                    Edit Profile
                    <a href="/PatientView/EmergencyContacts/@patientId" class="btn-secondary" style="text-decoration: none;">
    Emergency Contacts
</a>
                </a>
            </div>
        </div>
    </div>

    <div id="alert-container" class="alert alert-danger" style="display: none;">
        <span id="alert-message"></span>
    </div>

    <div class="profile-grid">
        <!-- Sidebar: Personal Info -->
        <div class="patient-info-sidebar">
            <div class="glass-card" style="padding: var(--spacing-lg);">
                <div style="display: flex; flex-direction: column; align-items: center; text-align: center; margin-bottom: var(--spacing-lg);">
                    <div class="patient-avatar" id="profile-avatar" style="width: 72px; height: 72px; font-size: 1.8rem; margin-bottom: var(--spacing-sm);">
                        -
                    </div>
                    <h3 id="profile-name" style="color: var(--text-main); font-weight: 600; font-size: 1.25rem;">-</h3>
                    <p id="profile-id" style="color: var(--text-muted); font-size: 0.85rem; margin-top: 2px;">Patient ID: #-</p>
                    <div id="profile-status-container" style="margin-top: 10px;">
                        <span class="status-badge status-pending">-</span>
                    </div>
                </div>

                <div class="info-row">
                    <span class="info-label">Age</span>
                    <span class="info-value" id="profile-age">-</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Gender</span>
                    <span class="info-value" id="profile-gender" style="text-transform: capitalize;">-</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Blood Type</span>
                    <span class="info-value" id="profile-blood-type">-</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Phone</span>
                    <span class="info-value" id="profile-phone">-</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Email</span>
                    <span class="info-value" id="profile-email" style="font-size: 0.85rem; word-break: break-all;">-</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Address</span>
                    <span class="info-value" id="profile-address" style="text-align: right; font-size: 0.85rem; max-width: 140px; word-wrap: break-word;">-</span>
                </div>
            </div>
        </div>

        <!-- Main Body: Medical History Timeline & Add Form -->
        <div style="display: flex; flex-direction: column; gap: var(--spacing-lg);">
            <!-- Diagnostic History List -->
            <div class="glass-card" style="padding: var(--spacing-lg);">
                <h3 style="color: var(--text-main); font-size: 1.25rem; font-weight: 600; border-bottom: 1px solid var(--border-glass); padding-bottom: var(--spacing-sm); display: flex; align-items: center; justify-content: space-between;">
                    Medical History
                    <span id="history-count-badge" style="background: var(--color-accent-glow); color: var(--color-accent); font-size: 0.75rem; padding: 2px 8px; border-radius: 10px;">0 records</span>
                </h3>

                <div class="history-timeline" id="history-list">
                    <div style="text-align: center; color: var(--text-muted); padding: var(--spacing-xl) 0;">
                        <div class="spinner"></div>
                        Retrieving records...
                    </div>
                </div>
            </div>

            <!-- Add Medical History Form -->
            <div class="glass-card" style="padding: var(--spacing-lg);">
                <h3 style="color: var(--text-main); font-size: 1.25rem; font-weight: 600; border-bottom: 1px solid var(--border-glass); padding-bottom: var(--spacing-sm); margin-bottom: var(--spacing-md);">
                    Add Diagnostic Record
                </h3>

                <form id="add-history-form" novalidate>
                    <input type="hidden" id="history-patient-id" value="@patientId" />
                    
                    <div class="form-group">
                        <label for="history-diagnosis" class="form-label">Diagnosis</label>
                        <input type="text" id="history-diagnosis" class="form-input" placeholder="e.g. Chronic Hypertension, Type 2 Diabetes" required />
                        <div id="history-diagnosis-error" class="input-error-msg">Diagnosis description is required.</div>
                    </div>

                    <div class="form-group">
                        <label for="history-notes" class="form-label">Clinical Notes & Observations</label>
                        <textarea id="history-notes" class="form-input" style="height: 120px; resize: vertical;" placeholder="Enter details regarding symptoms, prescriptions, and recommended treatments..."></textarea>
                    </div>

                    <div id="form-alert-container" class="alert alert-danger" style="display: none; margin-bottom: var(--spacing-md);">
                        <span id="form-alert-message"></span>
                    </div>

                    <button type="submit" class="btn-primary" style="width: 100%;">
                        Add Medical Record
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const patientId = '@patientId';
        const token = localStorage.getItem('token');

        document.addEventListener('DOMContentLoaded', function() {
            loadPatientProfile();
            loadMedicalHistory();

            // Set Edit Profile button link
            document.getElementById('btn-edit-profile').href = `/PatientView/Edit/${patientId}`;

            // Add Diagnostic Form submission
            document.getElementById('add-history-form').addEventListener('submit', handleAddHistory);
        });

        function calculateAge(dobString) {
            if (!dobString) return '-';
            const dob = new Date(dobString);
            const today = new Date();
            let age = today.getFullYear() - dob.getFullYear();
            const monthDiff = today.getMonth() - dob.getMonth();
            if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < dob.getDate())) {
                age--;
            }
            return age >= 0 ? age : 0;
        }

        async function loadPatientProfile() {
            const alertContainer = document.getElementById('alert-container');
            const alertMessage = document.getElementById('alert-message');

            try {
                const response = await fetch(`/api/patients/${patientId}`, {
                    method: 'GET',
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                if (response.status === 401) {
                    localStorage.removeItem('token');
                    localStorage.removeItem('user');
                    window.location.href = '/Account/Login';
                    return;
                }

                const result = await response.json();
                if (!response.ok || !result.success) {
                    throw new Error(result.message || 'Failed to fetch patient details.');
                }

                const patient = result.data;
                document.getElementById('profile-title-name').innerText = patient.fullName;
                document.getElementById('profile-name').innerText = patient.fullName;
                document.getElementById('profile-id').innerText = `Patient ID: #${patient.id}`;
                document.getElementById('profile-age').innerText = `${calculateAge(patient.dateOfBirth)} years`;
                document.getElementById('profile-gender').innerText = patient.gender;
                document.getElementById('profile-blood-type').innerText = patient.bloodType || '-';
                document.getElementById('profile-phone').innerText = patient.phone;
                document.getElementById('profile-email').innerText = patient.email;
                document.getElementById('profile-address').innerText = patient.address || '-';

                // Status Badge
                let statusClass = 'status-pending';
                if (patient.status.toLowerCase() === 'active') statusClass = 'status-active';
                if (patient.status.toLowerCase() === 'inactive') statusClass = 'status-inactive';
                
                document.getElementById('profile-status-container').innerHTML = `
                    <span class="status-badge ${statusClass}">${patient.status}</span>
                `;

                // Avatar initials
                const initials = patient.fullName
                    ? patient.fullName.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase()
                    : 'P';
                document.getElementById('profile-avatar').innerText = initials;

            } catch (error) {
                alertContainer.style.display = 'flex';
                alertMessage.innerText = error.message;
            }
        }

        async function loadMedicalHistory() {
            const historyList = document.getElementById('history-list');
            const countBadge = document.getElementById('history-count-badge');

            try {
                const response = await fetch(`/api/patients/${patientId}/medical-history`, {
                    method: 'GET',
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                const result = await response.json();
                if (!response.ok || !result.success) {
                    throw new Error(result.message || 'Failed to fetch medical history.');
                }

                const records = result.data;
                historyList.innerHTML = '';
                countBadge.innerText = `${records.length} record${records.length === 1 ? '' : 's'}`;

                if (records.length === 0) {
                    historyList.innerHTML = `
                        <div style="text-align: center; color: var(--text-muted); padding: 40px 0;">
                            <div style="font-size: 2.5rem; margin-bottom: var(--spacing-sm); color: var(--border-glass);">📋</div>
                            <div style="font-weight: 500;">No Medical History Records</div>
                            <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 4px;">Use the form below to register a diagnosis for this patient.</div>
                        </div>
                    `;
                    return;
                }

                records.forEach(record => {
                    const recordDate = new Date(record.createdAt).toLocaleDateString(undefined, {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    });

                    historyList.innerHTML += `
                        <div class="history-card">
                            <div class="history-date">${recordDate}</div>
                            <div class="history-diagnosis">${record.diagnosis}</div>
                            <div class="history-notes">${record.notes || '<span style="font-style: italic; color: var(--text-muted);">No clinical notes provided.</span>'}</div>
                        </div>
                    `;
                });

            } catch (error) {
                historyList.innerHTML = `
                    <div style="text-align: center; color: var(--color-error); padding: 20px 0;">
                        Failed to retrieve history: ${error.message}
                    </div>
                `;
            }
        }

        async function handleAddHistory(e) {
            e.preventDefault();

            const diagnosisInput = document.getElementById('history-diagnosis');
            const notesInput = document.getElementById('history-notes');
            const diagnosisError = document.getElementById('history-diagnosis-error');
            const formAlertContainer = document.getElementById('form-alert-container');
            const formAlertMessage = document.getElementById('form-alert-message');

            // Reset error states
            diagnosisInput.classList.remove('invalid');
            diagnosisError.style.display = 'none';
            formAlertContainer.style.display = 'none';

            if (!diagnosisInput.value.trim()) {
                diagnosisInput.classList.add('invalid');
                diagnosisError.style.display = 'block';
                return;
            }

            const submitBtn = e.target.querySelector('button[type="submit"]');
            const originalBtnText = submitBtn.innerText;
            submitBtn.disabled = true;
            submitBtn.innerText = 'Saving Record...';

            try {
                const response = await fetch(`/api/patients/${patientId}/medical-history`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({
                        patientId: parseInt(patientId),
                        diagnosis: diagnosisInput.value.trim(),
                        notes: notesInput.value.trim()
                    })
                });

                const result = await response.json();
                if (!response.ok || !result.success) {
                    throw new Error(result.message || 'Failed to submit diagnostic record.');
                }

                // Reset Form
                diagnosisInput.value = '';
                notesInput.value = '';

                // Reload History list dynamically
                loadMedicalHistory();

            } catch (error) {
                formAlertContainer.style.display = 'flex';
                formAlertMessage.innerText = error.message;
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerText = originalBtnText;
            }
        }
    </script>
}
