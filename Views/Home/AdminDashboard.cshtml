@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_Layout";
}

<!-- Client-side role enforcement backup -->
<script>
    const userStr = localStorage.getItem('user');
    if (!localStorage.getItem('token')) {
        window.location.href = '/Account/Login';
    } else if (userStr) {
        try {
            const user = JSON.parse(userStr);
            if (user.role !== 'Admin') {
                window.location.href = '/Account/UnauthorizedPage';
            }
        } catch (e) {
            console.error("Error parsing user info:", e);
        }
    }
</script>

<div class="container animate-fade-in" style="padding: var(--spacing-xl) 0;">
    <div style="display: flex; flex-direction: column; gap: var(--spacing-xl);">
        
        <!-- Welcome Hero Banner -->
        <div class="glass-card" style="background: linear-gradient(135deg, rgba(13, 21, 39, 0.7) 0%, rgba(139, 92, 246, 0.1) 100%); border-color: rgba(139, 92, 246, 0.25);">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--spacing-md);">
                <div>
                    <h1 style="font-size: 2.2rem; font-weight: 700; margin-bottom: var(--spacing-xs); background: linear-gradient(135deg, var(--text-main) 50%, var(--color-primary) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                        System Command Center
                    </h1>
                    <p style="color: var(--text-muted); font-size: 1.1rem;">Welcome back, <span id="admin-name" style="color: var(--text-main); font-weight: 600;">Administrator</span></p>
                </div>
                <div style="display: flex; gap: var(--spacing-sm);">
                    <span style="padding: 6px 16px; background: rgba(139, 92, 246, 0.15); border: 1px solid var(--color-accent); border-radius: 50px; color: var(--color-accent); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; box-shadow: 0 0 15px rgba(139, 92, 246, 0.25);">
                        System Admin
                    </span>
                </div>
            </div>
        </div>

        <!-- Quick Stats Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--spacing-lg);">
            
            <div class="glass-card" style="padding: var(--spacing-lg); border-left: 3px solid var(--color-primary);">
                <p style="font-size: 0.85rem; text-transform: uppercase; color: var(--text-muted); letter-spacing: 1px;">System Health</p>
                <h3 style="font-size: 1.8rem; margin: var(--spacing-xs) 0; color: var(--color-primary);">99.9%</h3>
                <p style="font-size: 0.8rem; color: var(--color-success); display: flex; align-items: center; gap: 4px;">
                    <span style="width: 6px; height: 6px; background-color: var(--color-success); border-radius: 50%; display: inline-block;"></span>
                    All Services Operational
                </p>
            </div>

            <div class="glass-card" style="padding: var(--spacing-lg); border-left: 3px solid var(--color-accent);">
                <p style="font-size: 0.85rem; text-transform: uppercase; color: var(--text-muted); letter-spacing: 1px;">User Directory</p>
                <h3 style="font-size: 1.8rem; margin: var(--spacing-xs) 0; color: var(--text-main);">14</h3>
                <p style="font-size: 0.8rem; color: var(--text-muted);">Active staff accounts</p>
            </div>

            <div class="glass-card" style="padding: var(--spacing-lg); border-left: 3px solid #E2E8F0;">
                <p style="font-size: 0.85rem; text-transform: uppercase; color: var(--text-muted); letter-spacing: 1px;">Database Sync</p>
                <h3 style="font-size: 1.8rem; margin: var(--spacing-xs) 0; color: var(--text-main);">SQLite</h3>
                <p style="font-size: 0.8rem; color: var(--color-primary);">Active & Connected</p>
            </div>

            <div class="glass-card" style="padding: var(--spacing-lg); border-left: 3px solid var(--color-error);">
                <p style="font-size: 0.85rem; text-transform: uppercase; color: var(--text-muted); letter-spacing: 1px;">Open Security Alerts</p>
                <h3 style="font-size: 1.8rem; margin: var(--spacing-xs) 0; color: var(--color-error);">0</h3>
                <p style="font-size: 0.8rem; color: var(--text-muted);">No actions required</p>
            </div>

        </div>

        <!-- Admin Control Panels -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: var(--spacing-lg);">
            
            <!-- System Settings -->
            <div class="glass-card">
                <div style="display: flex; align-items: center; gap: var(--spacing-md); margin-bottom: var(--spacing-lg);">
                    <div style="background: rgba(14, 237, 198, 0.1); border: 1.5px solid var(--color-primary); width: 45px; height: 45px; border-radius: 12px; display: flex; justify-content: center; align-items: center; color: var(--color-primary);">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="3"></circle>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                        </svg>
                    </div>
                    <div>
                        <h3 style="font-size: 1.2rem; font-weight: 600;">System Controls</h3>
                        <p style="color: var(--text-muted); font-size: 0.85rem;">Global configurations</p>
                    </div>
                </div>

                <div style="display: flex; flex-direction: column; gap: var(--spacing-sm);">
                    <a href="/Home/AnalyticsDashboard" class="btn-primary" style="text-align: center; text-decoration: none; display: block; font-weight: 600;">
                        Analytics Dashboard
                    </a>
                    <a href="/PatientView" class="btn-secondary" style="text-align: center; text-decoration: none; display: block; font-weight: 500;">
                        Manage Patient Registry
                    </a>
                    <a href="/AppointmentView" class="btn-secondary" style="text-align: center; text-decoration: none; display: block; font-weight: 500;">
                        Appointment Schedule
                    </a>
                    <a href="/InvoiceView" class="btn-secondary" style="text-align: center; text-decoration: none; display: block; font-weight: 500;">
                        Billing & Financials
                    </a>
                    <a href="/swagger" class="btn-secondary" style="text-align: center; text-decoration: none; display: block; font-weight: 500;">
                        Swagger API Docs
                    </a>
                </div>
            </div>

            <!-- Database & Storage Info -->
            <div class="glass-card">
                <div style="display: flex; align-items: center; gap: var(--spacing-md); margin-bottom: var(--spacing-lg);">
                    <div style="background: rgba(139, 92, 246, 0.1); border: 1.5px solid var(--color-accent); width: 45px; height: 45px; border-radius: 12px; display: flex; justify-content: center; align-items: center; color: var(--color-accent);">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                            <path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3"></path>
                        </svg>
                    </div>
                    <div>
                        <h3 style="font-size: 1.2rem; font-weight: 600;">Database Stats</h3>
                        <p style="color: var(--text-muted); font-size: 0.85rem;">SQLite Instance</p>
                    </div>
                </div>

                <div style="display: flex; flex-direction: column; gap: var(--spacing-md); font-size: 0.95rem;">
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-glass); padding-bottom: var(--spacing-xs);">
                        <span style="color: var(--text-muted);">Database Name:</span>
                        <span>healthcare_crm.db</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-glass); padding-bottom: var(--spacing-xs);">
                        <span style="color: var(--text-muted);">ORM Provider:</span>
                        <span>Entity Framework Core</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-glass); padding-bottom: var(--spacing-xs);">
                        <span style="color: var(--text-muted);">Admin Session Status:</span>
                        <span style="color: var(--color-primary); font-weight: 500;">Authorized</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Load admin name dynamically from localStorage
        if (userStr) {
            try {
                const user = JSON.parse(userStr);
                if (user.fullName) {
                    document.getElementById('admin-name').innerText = user.fullName;
                }
            } catch (e) {
                console.error("Error setting admin name:", e);
            }
        }
    </script>
}
